{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dw14-photo-gallery",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Our own entry (Paraglide middleware around Start's handler). The
  // package's "@tanstack/react-start/server-entry" export is Start's bare
  // default entry and would bypass src/server.ts entirely.
  "main": "./src/server.ts",
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "binding": "ASSETS",
  },
}